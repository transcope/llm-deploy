# =============================================================================
# V100 服务器连接信息模板
#
# 用法:
#   1. 复制本文件为 .env:  cp configs/.env.example configs/.env
#   2. 在 .env 中填入真实值 (不要提交 .env 到 git)
#   3. 加载环境变量:  source cases/v100/load_env.sh
#
# 文档中的 ${V100_HOST} 等占位符即对应此处变量。
# =============================================================================

# SSH 登录信息
V100_HOST=your_server_ip
V100_USER=your_username
V100_PASSWORD=your_password_here
V100_PORT=22

# Docker 容器名
V100_CONTAINER=your_container_name

# 项目工作目录 (容器内)
V100_WORKDIR=/volume/workspace/llm-deploy
